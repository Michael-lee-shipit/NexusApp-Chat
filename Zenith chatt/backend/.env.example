# Copy this file to .env and fill in provider credentials.
# Set SESSION_SECRET to a long random value before exposing the API publicly.
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_HTTPS_ONLY=false
FRONTEND_ORIGINS=null,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:8000,http://127.0.0.1:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Authorization callback URL: http://127.0.0.1:8000/auth/github/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
# OAuth 2.0 callback URL: http://127.0.0.1:8000/auth/x/callback
